# Copy to backend/.env and frontend/.env.local (same JWT_SECRET in both).

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms

# Must be identical in backend and frontend
JWT_SECRET=replace-with-a-long-random-secret

# Seed the first admin (backend only)
ADMIN_EMAIL=admin@saptakoshi.com
ADMIN_PASSWORD=changeme

# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Depreciation automation cron (backend only). Disabled by default.
# DEPRECIATION_CRON_ENABLED=true
# DEPRECIATION_CRON_SCHEDULE=0 * * * *
# Allow register book_value as prior accumulated dep when prior FY final run is missing (migration only).
# DEPRECIATION_LEGACY_REGISTER_CARRY_FORWARD=false
# Optional: enables POST /internal/jobs/depreciation/run-now with header X-Internal-Job-Token
# DEPRECIATION_AUTOMATION_MANUAL_TOKEN=replace-with-a-long-random-secret

# Frontend (server-side; URL of Express API)
BACKEND_URL=http://localhost:4000
