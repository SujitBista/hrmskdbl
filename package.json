{
  "name": "hrmskdbl",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/depreciation-core"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/test-results/html-report"
  },
  "devDependencies": {
    "@hrmskdbl/depreciation-core": "file:packages/depreciation-core",
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
